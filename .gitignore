# --- Dependencies ---
node_modules/

# --- Build / TypeScript output ---
dist/
build/
*.tsbuildinfo

# --- Local results from running examples (regenerated on every run) ---
output/

# --- Secrets and local env ---
# .env.example IS tracked; everything else is not.
.env
.env.*
!.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor & IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS junk ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Optional: uncomment if you don't want personal PDFs to leak ---
# samples/*.pdf
# !samples/README.md
