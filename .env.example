# Nutrient DWS Processor API credentials.
#
# Get your key:
#   1. Sign up: https://dashboard.nutrient.io/sign_up/?product=processor
#   2. Copy your live API key from https://dashboard.nutrient.io/processor-api/api_keys/
#
# Free tier: 200 credits / month. Key-value extraction is 3 credits/call;
# tables and text extraction are typically 1 credit/call. See:
#   https://www.nutrient.io/guides/dws-processor/pricing/calculate-credit-usage/
DWS_API_KEY=replace_me

# DWS base URL.
#
#   Production (default): https://api.nutrient.io
#   Local DWS Dashboard:  http://localhost:4000   ← the local dev version of
#                                                   the DWS Dashboard (e.g.,
#                                                   the PSPDFKit `hosted` repo
#                                                   running via docker-compose).
#                                                   Same Bearer-auth + /build
#                                                   API surface as production.
#
# When using the local DWS Dashboard, mint an API key from its UI and put it
# in DWS_API_KEY above — the value will only be valid against that instance.
DWS_BASE_URL=https://api.nutrient.io

# OCR language used for scanned PDFs. See:
#   https://www.nutrient.io/guides/document-engine/ocr/language-support/
OCR_LANGUAGE=english
